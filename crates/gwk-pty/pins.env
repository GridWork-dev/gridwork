# The pins that decide what `gwk-pty` links against. CI sources this file;
# nothing here is typed a second time anywhere else.
#
# Re-pinning is budgeted at one per phase (SPEC risk R3). The three version pins
# move together: libghostty-vt is pre-1.0 and its checked-in FFI bindings track a
# specific ghostty revision, so a ghostty bump without a crate bump is how you
# get a binding that compiles and lies about the struct layout underneath it.

# Zig 0.15.2 is ghostty's own `minimum_zig_version` at GHOSTTY_COMMIT below.
# Distros are already past it (Arch ships 0.16), so a system Zig is the wrong
# Zig by default — this pin is not belt-and-braces, it is the only correct one.
ZIG_VERSION=0.15.2

# The x86_64-linux tarball for ZIG_VERSION, so `tools/zig-bootstrap.sh` can
# check what it downloaded instead of trusting the transport. CI does not read
# this — `mlugg/setup-zig` verifies its own download against the upstream
# minisign signature, which is strictly better and is why this is only for
# humans on a clean clone.
#
# One platform, not a table. Every machine that builds this crate today is
# x86_64 linux, and a table of five checksums where four are never executed is
# four chances to be confidently wrong.
ZIG_SHA256_X86_64_LINUX=02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239

# The exact revision libghostty-vt-sys 0.2.1 pins in its own build.rs. Using its
# pin rather than picking our own is deliberate: the crate ships pre-generated
# bindings from `ghostty/vt.h` at this revision, and a different revision means
# bindings that no longer match the C ABI they were generated against.
GHOSTTY_COMMIT=a887df42c56f6de86c0fe6da9c4eeca37931e083

# Exact-pinned, not a caret range. libghostty-vt is pre-1.0 and its own docs say
# breaking changes are expected, so `0.2` would let a patch release move the ABI
# under a green lockfile.
LIBGHOSTTY_VT_VERSION=0.2.1
