# systemd unit for the gwk-pty-host resident process.
#
# This file is the SYSTEM-scope reference. A deployment may also run it as a
# user unit (`systemctl --user`) — drop the `User=`/`Group=` lines (a user
# manager cannot switch users; the unit already runs as its owner, which
# satisfies the same-EUID requirement below when that owner is the kernel
# daemon's user) and install under `default.target` instead of
# `multi-user.target`. The reference host runs it that way.
#
# No in-repo packaging convention exists yet to follow: neither the kernel
# (`crates/gwk-kernel`) nor `gw` (`crates/gridwork`) ships a systemd unit in
# this repository, so there is nothing to copy from. What follows is derived
# instead from `docs/operations.md`'s own description of the kernel daemon's
# startup/shutdown contract — SIGTERM handled, not just Ctrl-C;
# `notify_ready()`'s READY=1 datagram on `$NOTIFY_SOCKET` — and this crate's
# own hard floor: no credential store, no listening network surface of its
# own.

[Unit]
Description=GridWork PTY engine host (gwk-pty-host)
Documentation=https://github.com/GridWork-dev/gridwork
# Ordering only — this repo carries no gwk-kernel.service to depend on yet.
# Add `After=gwk-kernel.service` (and `Requires=` if the kernel's own unit
# ever gains one) the day that unit exists; until then this process fails
# its own startup health probe loudly rather than silently racing a kernel
# that is not there.
After=network.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/gwk-pty-host
Restart=on-failure
RestartSec=2s

# The kernel authenticates a peer by its Unix-socket EUID alone (ADR 0002;
# `crates/gwk-kernel/src/wire/listen.rs`'s `admits`) — this process MUST run
# as the exact same user the kernel daemon does, or every command it
# originates is refused at the handshake before a byte of the request is
# even read. Set to the real deployment user; left commented here rather
# than guessed, because a wrong guess that happens to "work" (matched by
# accident) is worse than an obviously-unset one that fails loudly on first
# boot.
# User=gridwork
# Group=gridwork

# Where the kernel's own socket lives. Omit to use the same
# /run/gridwork/gwk.sock default both `gw` and the kernel daemon read
# (`gwk_kernel::DEFAULT_SOCKET_PATH`, `GWK_SOCKET_PATH`) — set only if a
# deployment moved it.
# Environment=GWK_SOCKET_PATH=/run/gridwork/gwk.sock

# The sessions this host runs and publishes: comma-separated
# name=engine:COLSxROWS entries (see `crates/gwk-pty-host/src/publish.rs`).
# Omit or leave empty to run none — a legal resident state. A malformed
# value, an engine no adapter claims, or a child that cannot spawn fails
# the unit loudly at start rather than serving half a declaration.
# Environment=GWK_PTY_HOST_SESSIONS=console=opencode:100x30

# This process adds no credential store and no listening network surface of
# its own (see `crates/gwk-pty-host/src/lib.rs`) — it only ever CONNECTS out.
# Its CHILDREN are another matter, and three of the original hardening lines
# moved the day the host began supervising real engine TUIs instead of
# nothing, because a child shares the unit's namespace:
#
#   * RestrictAddressFamilies gains AF_INET/AF_INET6 — an engine TUI talks
#     to its own provider. The host still binds nothing; the family list is
#     about who a child may DIAL, and a host build that tried to bind a
#     listener would still fail review before it failed a syscall.
#   * MemoryDenyWriteExecute is gone — the engines are JIT runtimes.
#   * The home becomes writable (ReadWritePaths under ProtectSystem=strict)
#     — every engine keeps its own state under it. Point it at the
#     deployment user's real home.
# Derivation: CAP-005 — on the reference deployment, a transient unit with
# PrivateDevices=yes exposed all three PTY device paths while both
# posix_openpt(3) and open("/dev/ptmx") failed ENOENT; the control unit was
# clean.
#   * PrivateDevices is gone — engine children need the PTY allocation path
#     the captured unit refused before any session could exist.
#
# The engines' TUIs also consult TERM, which a service manager does not
# set; the value here is a deployment choice for what the sessions report,
# not a fact about any engine.
Environment=TERM=xterm-256color
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/gridwork
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
