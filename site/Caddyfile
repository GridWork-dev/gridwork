{
	admin off
	persist_config off
	auto_https off
}

# The security header floor, defined once so the 200 path and the error path
# cannot drift apart. Applied to every response, including errors.
(sec_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The page is one self-contained document: inline <style>, a data: favicon,
		# zero scripts and zero external requests. Deny everything else outright.
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
}

# Railway injects $PORT and terminates TLS at the edge.
:{$PORT:80} {
	root * /usr/share/caddy
	encode zstd gzip
	file_server

	import sec_headers

	# Errors (404, method-not-allowed, …) route through a separate chain, so the
	# header floor above would not reach them — re-apply it and answer the status.
	handle_errors {
		import sec_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
