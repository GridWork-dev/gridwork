{
  "name": "@gridwork/site",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "assets:sync": "bun scripts/sync-public-assets.ts",
    "dev": "bun run assets:sync && next dev",
    "build": "bun run assets:sync && next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
