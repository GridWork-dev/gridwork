{
  "name": "@gridwork/site",
  "private": true,
  "scripts": {
    "assets:sync": "bun scripts/sync-public-assets.ts",
    "dev": "bun run assets:sync && GRIDWORK_ORIGIN_SECRET_MODE=disabled next dev",
    "build": "bun test && bun run assets:sync && bun run check:docs && next build",
    "check:docs": "bun scripts/check-doc-freshness.ts",
    "knip": "knip",
    "start": "node .next/standalone/server.js",
    "test": "bun test",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.14.3",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.14.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "knip": "6.32.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.78.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.3.14"
}
