{
  "name": "@gridwork/site",
  "private": true,
  "scripts": {
    "assets:sync": "bun scripts/sync-public-assets.ts",
    "dev": "bun run assets:sync && next dev",
    "build": "bun test && bun run assets:sync && bun run check:docs && next build",
    "check:docs": "bun scripts/check-doc-freshness.ts",
    "check:tokens": "bun run tools/design-tokens/index.ts tokens.config.json",
    "knip": "knip",
    "parity": "bun scripts/parity.ts",
    "test": "bun test",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.17",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.38.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "packageManager": "bun@1.3.14"
}
