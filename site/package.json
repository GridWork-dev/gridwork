{
  "name": "@gridwork/site",
  "private": true,
  "scripts": {
    "assets:sync": "bun scripts/sync-public-assets.ts",
    "dev": "bun run assets:sync && next dev",
    "build": "bun test && bun run assets:sync && bun run check:docs && next build",
    "check:docs": "bun scripts/check-doc-freshness.ts",
    "check:tokens": "bun run tools/design-tokens/index.ts tokens.config.json",
    "knip": "knip",
    "parity": "bun scripts/parity.ts",
    "test": "bun test",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.3.14"
}
