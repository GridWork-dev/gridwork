{
  // The repo-root entry. One oxlint invocation from here covers every TypeScript file in
  // the repo — `contracts/` under this config, `site/` under its own nested
  // `site/.oxlintrc.json`, which oxlint discovers and applies per-directory.
  //
  // Lint walks the whole tree by default and FORMAT names its two trees positionally
  // (tools/format.sh). That asymmetry is deliberate: an unlinted new directory is a
  // silent coverage hole, while a formatted-by-accident generated file is a red gate. The
  // default that fails safe points the opposite way for each, so each gets its own.
  //
  // There is deliberately no second oxlint install under `contracts/`. The binary is
  // pinned once, in `site/package.json`, and both trees are linted by the same process. A
  // second install is a second version to drift.
  "$schema": "./site/node_modules/oxlint/configuration_schema.json",

  "extends": ["./tools/oxlint-config/base.oxlintrc.json"],

  // Re-listed IN FULL rather than appended: `ignorePatterns` REPLACES the inherited list
  // rather than merging with it — the same trap that applies to `plugins` and
  // `overrides`, and it crosses `extends`. The first four are the base's; the rest are
  // this repo's.
  //
  // `contracts/bindings.ts` and `contracts/goldens-ts/` are generated by
  // `cargo run -p xtask -- contract` and diffed byte-for-byte by CI. A linter reporting on
  // them is noise nobody may act on — the fix would have to land in the Rust generator,
  // and any edit here reds the contract gate.
  //
  // `tools/oxlint-config/` is the vendored house floor, byte-pinned against its canonical
  // copy by tools/vendored-config-drift.test.ts. Linting it can only produce findings that are
  // unfixable here by construction: the fix belongs upstream, and applying it locally is
  // the exact fork D3 exists to prevent.
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/*.d.ts",
    "contracts/bindings.ts",
    "contracts/goldens-ts/**",
    "tools/oxlint-config/**",
    "target/**",
    ".zig-packages/**"
  ]
}
